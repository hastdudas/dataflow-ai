# =====================================================================
# Shuketter - environment variables
# ---------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. NEVER commit real keys.
# =====================================================================

# --- App -------------------------------------------------------------
# Public origin of the app. Used for SEO metadata, Stripe redirect URLs
# and the Supabase magic-link redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production: https://shuketter.com

# Max upload size in megabytes (default 10).
# NOTE: Vercel serverless functions cap request bodies at ~4.5MB.
# See README "10MBの上限について".
NEXT_PUBLIC_MAX_UPLOAD_MB=10

# --- Supabase --------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key. SERVER ONLY. Never expose to the browser,
# never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Stripe ----------------------------------------------------------
# Developers -> API keys
STRIPE_SECRET_KEY=sk_test_xxx
# Price ID of the 980 JPY / month recurring price
STRIPE_PRICE_ID=price_xxx
# Developers -> Webhooks -> signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Plan limits -----------------------------------------------------
FREE_MONTHLY_LIMIT=3
PRO_MONTHLY_LIMIT=50
